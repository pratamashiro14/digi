# Blokir akses langsung ke library pihak ketiga (mis. lib/PHPMailer/src/*.php).
# File-file di sini hanya boleh dipakai lewat require_once dari PHP internal
# (mis. mailer.php), tidak pernah diakses langsung lewat URL browser.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
