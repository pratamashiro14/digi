# Config editor Claude Code (tidak perlu ikut ke repo)
.claude/

# Konfigurasi rahasia (kredensial DB & key Midtrans) — JANGAN commit
config.php
admin/config.php

# Dependencies (hasil npm install — biar ringan, install sendiri)
# CATATAN: /vendor/ di proyek ini BUKAN composer, melainkan aset front-end
# (bootstrap, jquery, sweetalert, dll) yang dibutuhkan situs — jadi IKUT di-track
# supaya git-deploy ke hosting langsung lengkap. Jangan tambahkan /vendor/ di sini.
node_modules/

# Laravel environment & runtime
/laravel-app/.env
/laravel-app/.env.backup
/laravel-app/.phpunit.result.cache
/laravel-app/storage/*.key
/laravel-app/storage/framework/cache/*
/laravel-app/storage/framework/sessions/*
/laravel-app/storage/framework/views/*
/laravel-app/storage/logs/*
/laravel-app/bootstrap/cache/*
/laravel-app/public/storage
/laravel-app/public/hot

# File upload user (bukan bagian source code)
/uploads/*
!/uploads/.gitkeep

# Backup lokal (dump database & file KTP asli sebelum migrasi) — JANGAN
# pernah commit, berisi data pribadi (NIK, foto KTP) & isi database mentah.
/database/backup/

# Build / compiled assets
/laravel-app/public/build

# Log & cache
*.log
*.cache

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
